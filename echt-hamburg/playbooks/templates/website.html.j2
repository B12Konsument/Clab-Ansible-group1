<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ franchise_name | e }}</title>
  </head>
  <body>
    <main>
      <h1>{{ franchise_name | e }}</h1>
      <p>Regionale Produkte und Veranstaltungen in Hamburg für Einheimische und Gäste.</p>
      <h2>Projektgruppe: {{ group_name | e }}</h2>
      <h3>Mitglieder</h3>
      <ul>
{% for member in group_members %}
        <li>{{ member | e }}</li>
{% endfor %}
      </ul>
    </main>
  </body>
</html>

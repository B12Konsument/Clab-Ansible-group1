hostname S1-{{ franchise_name | upper | replace(' ', '-') }}
no ip domain lookup
no service password-encryption
no enable secret
enable password {{ enable_password }}
username admin privilege 15 password admin
username netadmin privilege 15 password admin
ip domain name {{ domain_name }}
ip ssh version 2
banner motd ^C
*** {{ franchise_name }} | {{ group_name }} ***
Unbefugter Zugriff ist verboten.
Gott Strafe Cisco
^C
!
! IOL benötigt IP-Routing für den separaten gerouteten Docker-Bootstrap-Port.
vtp mode transparent
!
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% endfor %}
!
interface {{ switch_trunk_port }}
 description 802.1Q-Trunk-zu-R1
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 1
 switchport trunk allowed vlan {{ vlans | map(attribute='id') | join(',') }}
 switchport mode trunk
 no shutdown
!
{% for vlan in vlans %}
interface {{ vlan.switch_port }}
 description {{ vlan.node }}
 switchport access vlan {{ vlan.id }}
 switchport mode access
 spanning-tree portfast
{% if vlan.id == 10 %}
 ! Optionale Port-Security wie in hw; erst mit echter Client-MAC aktivieren.
 !switchport port-security
 !switchport port-security maximum 1
 !switchport port-security mac-address sticky
 !switchport port-security violation shutdown
{% endif %}
 no shutdown
!
{% endfor %}
{% for port in switch_unused_ports %}
interface {{ port }}
 description UNGENUTZT
 shutdown
!
{% endfor %}
interface Vlan99
 description Management-SVI
 ip address {{ switch_management_ip }} {{ lan_netmask }}
 no shutdown
!
ip default-gateway {{ (vlans | selectattr('id', 'equalto', 99) | first).gateway }}
!
line vty 0 4
 login local
 transport input ssh

hostname R1-{{ franchise_name | upper | replace(' ', '-') }}
no ip domain lookup
no service password-encryption
no enable secret
service timestamps log datetime msec
enable password {{ enable_password }}
username admin privilege 15 password admin
username netadmin privilege 15 password admin
ip domain name {{ domain_name }}
ip ssh version 2
banner motd ^C
*** {{ franchise_name }} | {{ group_name }} ***
Unbefugter Zugriff ist verboten.
^C
!
{% for vlan in vlans %}
ip dhcp excluded-address {{ vlan.gateway }}{{ (' ' ~ switch_management_ip) if vlan.id == 99 else '' }}
ip dhcp pool {{ vlan.name }}
 network {{ vlan.network }} {{ lan_netmask }}
 default-router {{ vlan.gateway }}
 domain-name {{ domain_name }}
!
{% endfor %}
ip access-list standard 1
{% for vlan in vlans %}
 {{ loop.index * 10 }} permit {{ vlan.network }} 0.0.0.255
{% endfor %}
!
ip nat inside source list 1 interface {{ router_internet_port }} overload
ip route 0.0.0.0 0.0.0.0 {{ public_peer }}
!
interface {{ router_trunk_port }}
 description 802.1Q-Trunk-zu-S1
 no ip address
 no shutdown
!
{% for vlan in vlans %}
interface {{ router_trunk_port }}.{{ vlan.id }}
 encapsulation dot1Q {{ vlan.id }}
 ip address {{ vlan.gateway }} {{ lan_netmask }}
 ip nat inside
!
{% endfor %}
interface {{ router_internet_port }}
 description Internet-Uplink
 ip address {{ public_ip }} {{ public_netmask }}
 ip nat outside
 no shutdown
!
line vty 0 4
 login local
 transport input ssh

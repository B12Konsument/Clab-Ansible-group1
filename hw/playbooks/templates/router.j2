no ip domain lookup
!
access-list 1 permit 192.168.0.0 0.0.255.255
!
ip nat inside source list 1 interface {{ router_wan }} overload
!
! Webserver von außen veröffentlichen
!
ip nat inside source static tcp 192.168.30.10 80 interface {{ router_wan }} 80
ip nat inside source static tcp 192.168.30.10 443 interface {{ router_wan }} 443
!
service timestamps log datetime msec
!
banner motd ^C
*** {{ franchise_name }} | {{ group_name }} ***
Unbefugter Zugriff ist verboten.
Gott Strafe Cisco
^C
!
ip dhcp excluded-address 192.168.10.1
ip dhcp excluded-address 192.168.20.1
ip dhcp excluded-address 192.168.30.1
ip dhcp excluded-address 192.168.99.1 192.168.99.33
!
ip dhcp pool CUSTOMER-SUPPORT
 network 192.168.10.0 255.255.255.0
 default-router 192.168.10.1
 dns-server 10.14.213.11 10.14.213.13
 domain-name echt-hamburg.de
!
ip dhcp pool IT
 network 192.168.20.0 255.255.255.0
 default-router 192.168.20.1
 dns-server 10.14.213.11 10.14.213.13
 domain-name echt-hamburg.de
!
ip dhcp pool WEBSERVER
 network 192.168.30.0 255.255.255.0
 default-router 192.168.30.1
 dns-server 10.14.213.11 10.14.213.13
 domain-name echt-hamburg.de
!
ip dhcp pool MANAGEMENT
 network 192.168.99.0 255.255.255.0
 default-router 192.168.99.1
 dns-server 10.14.213.11 10.14.213.13
 domain-name echt-hamburg.de
!
!
! ACL: SSH nur aus Management-VLAN
!
access-list 10 permit 192.168.99.0 0.0.0.255
!
!
! ACL: HTTP/HTTPS
! VLAN 10, 20 und 99 dürfen keinen HTTP/HTTPS-Traffic
! als Ziel haben.
! VLAN 30 darf HTTP/HTTPS empfangen.
!
ip access-list extended INTER-VLAN-WEB
!
! Bereits etablierte TCP-Verbindungen zurück erlauben
 permit tcp any 192.168.10.0 0.0.0.255 established
 permit tcp any 192.168.20.0 0.0.0.255 established
 permit tcp any 192.168.99.0 0.0.0.255 established
!
! Neue HTTP/HTTPS-Verbindungen zu VLAN 10/20/99 verhindern
 deny tcp any 192.168.10.0 0.0.0.255 eq 80
 deny tcp any 192.168.10.0 0.0.0.255 eq 443
 deny tcp any 192.168.20.0 0.0.0.255 eq 80
 deny tcp any 192.168.20.0 0.0.0.255 eq 443
 deny tcp any 192.168.99.0 0.0.0.255 eq 80
 deny tcp any 192.168.99.0 0.0.0.255 eq 443
!
! HTTP/HTTPS zum Webserver erlauben
 permit tcp any 192.168.30.0 0.0.0.255 eq 80
 permit tcp any 192.168.30.0 0.0.0.255 eq 443
!
 permit ip any any
!
ip access-list extended WAN-IN
 permit tcp any any established
 permit udp any eq 53 any
 permit tcp any any eq 80
 permit tcp any any eq 443
 permit icmp any any
 deny ip any any log
!
interface {{ router_trunk }}
 description 802.1Q-Trunk-zu-S1
 no ip address
 no shutdown
 ip nat inside
!
interface {{ router_trunk }}.10
 encapsulation dot1Q 10
 description CustomerSupport
 ip address 192.168.10.1 255.255.255.0
 ip nat inside
 ip access-group INTER-VLAN-WEB in
!
interface {{ router_trunk }}.20
 encapsulation dot1Q 20
 description IT
 ip address 192.168.20.1 255.255.255.0
 ip nat inside
 ip access-group INTER-VLAN-WEB in
!
interface {{ router_trunk }}.30
 encapsulation dot1Q 30
 description Webserver
 ip address 192.168.30.1 255.255.255.0
 ip nat inside
 ip access-group INTER-VLAN-WEB in
!
interface {{ router_trunk }}.99
 encapsulation dot1Q 99
 description Management
 ip address 192.168.99.1 255.255.255.0
 ip nat inside
 ip access-group INTER-VLAN-WEB in
!
interface {{ router_wan }}
 description WAN Interface
 ip address dhcp
 ip nat outside
 ip access-group WAN-IN in
!
line vty 0 4
 login local
 transport input ssh
 access-class 10 in
!
